APP_ENV=development

SYMBOL=XAUUSD
SIGNAL_ID_PREFIX=GOLD

DATABASE_URL=postgresql+asyncpg://gold:gold@postgres:5432/goldbot

REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=

TELEGRAM_SHOW_METADATA=true
TELEGRAM_ENABLED=true
TELEGRAM_SYMBOL_LABEL=GOLD
TELEGRAM_MAX_RETRIES=3
TELEGRAM_POLL_TIMEOUT_SECONDS=30

REPORT_TIME=23:55
REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# Confluence tiers (Section 16): < WATCH = NO_TRADE, WATCH..VALID..STRONG..VERY_STRONG.
WATCH_SIGNAL_CONFIDENCE=0.68
MIN_SIGNAL_CONFIDENCE=0.75
STRONG_SIGNAL_CONFIDENCE=0.82
VERY_STRONG_SIGNAL_CONFIDENCE=0.90
REVERSAL_SIGNAL_CONFIDENCE=0.82
INVALIDATION_CONFIDENCE_FLOOR=0.35

# Tỉ lệ (0-1), tính trên số phương pháp thực sự ra hướng BUY/SELL (bỏ qua NEUTRAL) -
# ví dụ 2 BUY/0 SELL/4 NEUTRAL -> agreement ratio = 2/2 = 1.0. RSI Momentum, Fibonacci,
# Liquidity/SMC, Multi-timeframe đã bị loại khỏi pipeline (app/workers/analysis_worker.py)
MIN_METHOD_AGREEMENT=0.5
STRONG_METHOD_AGREEMENT=0.7

SIGNAL_COOLDOWN_MINUTES=20
MAX_SIGNALS_PER_HOUR=3

MIN_RR=1.5

# STRATEGY_WEIGHTS overrides app/core/strategy_weights.py's defaults if set - JSON
# object keyed by strategy name, e.g. {"market_structure": 1.3, "rsi_momentum": 0.7}.
# Leave unset to use the built-in Section 17 defaults.
# STRATEGY_WEIGHTS={"market_structure":1.3,"support_resistance":1.15,"ema_trend":0.8,"rsi_momentum":0.7,"macd":0.65,"volatility":0.7,"fibonacci":0.85,"price_action":1.0,"liquidity_smc":1.3,"multi_timeframe":1.35}

# Which timeframe the analysis worker trades on (M1/M5/M15/M30/H1/H4/D1). Kết quả
# confluence chỉ đổi khi có nến PRIMARY_TIMEFRAME mới đóng (chạy nhanh hơn không cho
# thêm thông tin), nên ANALYSIS_INTERVAL_SECONDS chỉ quyết định độ trễ tối đa giữa
# lúc nến đóng và lúc bot phát hiện - không phải tốc độ phản ứng giá (việc đó do
# TRACKING_INTERVAL_SECONDS đảm nhiệm, chạy mỗi 15s không phụ thuộc interval này).
# 300s (5 phút) vẫn an toàn với TwelveDataProvider free tier (800 request/ngày) kể
# từ khi multi_timeframe bị loại khỏi pipeline (mỗi chu kỳ chỉ còn ~2 credit).
PRIMARY_TIMEFRAME=M15
ANALYSIS_INTERVAL_SECONDS=300
TRACKING_INTERVAL_SECONDS=15
ENTRY_MAX_CHASE_ATR_MULT=1.3
ENTRY_EXPIRY_MINUTES=120

# mock | tradingview | broker | twelvedata
MARKET_DATA_PROVIDER=mock

TRADINGVIEW_SYMBOL=OANDA:XAUUSD
TRADINGVIEW_WEBHOOK_SECRET=

MOCK_BASE_PRICE=2650.0

# BrokerProvider: OANDA v20 REST API (practice account, free) - https://developer.oanda.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_INSTRUMENT=XAU_USD

# TwelveDataProvider: free-tier market data API (email signup only, no trading
# account needed) - https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD

PAPER_MODE=true

SIGNAL_GENERATION_ENABLED=true

LOG_LEVEL=INFO
LOG_JSON=false
